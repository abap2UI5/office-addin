{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/.abaplint-deps/steampunk",
      "files": "/src/**/*.*"
    },
    {
      // main, declared (CONVENTIONS section 9): the demo needs the abap2UI5
      // with z2ui5.cc.ExcelBridge (#2847), which no release has yet - its
      // ABAP uses nothing newer than 1.146.0, so a release tag can replace
      // this with the first release that ships the control
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "main",
      "folder": "/.abaplint-deps/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {
    // --- correctness ---
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true,
    "unreachable_code": true,
    "unused_variables": true,
    "unused_types": true,
    "unused_methods": true,
    "identical_conditions": true,
    "identical_contents": true,
    "empty_statement": true,
    "ambiguous_statement": true,
    "obsolete_statement": true,
    "commented_code": true,
    "when_others_last": true,
    "constructor_visibility_public": true,
    "allowed_object_types": {
      "allowed": ["CLAS", "DEVC", "SICF", "WAPA"]
    },
    // --- style ---
    "exporting": true,
    "omit_parameter_name": true,
    "line_length": {
      "length": 255
    },
    "definitions_top": true,
    "contains_tab": true,
    // src/02 is the generated BSP: abapGit stores its pages as rows padded
    // to 255 characters (scripts/build-bsp.mjs, checked by npm run bsp:check)
    "whitespace_end": { "exclude": ["/src/02/z2ui5_xl"] },
    "sequential_blank": {
      "lines": 3
    },
    "max_one_statement": true,
    "colon_missing_space": true,
    "keyword_case": {
      "style": "upper",
      "ignoreExceptions": true,
      "ignoreLowerClassImplmentationStatement": true,
      "ignoreKeywords": []
    },
    "types_naming": {
      "pattern": "^TY_"
    },
    "object_naming": {
      "patternKind": "required",
      "clas": "^Z2UI5_CL_XL_"
    },
    "functional_writing": true,
    "no_chained_assignment": true,
    "names_no_dash": true,
    "preferred_compare_operator": true,
    "use_line_exists": true,
    "prefer_is_not": true,
    "avoid_use": {
      "define": true,
      "endselect": true,
      "execSQL": true,
      "kernelCall": true,
      "communication": true,
      "statics": true,
      "systemCall": true,
      "defaultKey": true,
      "break": true
    }
  }
}
